{
    "version": 2,
    "builds": [
        {
            "src": "client/package.json",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "dist"
            }
        },
        {
            "src": "server/src/index.ts",
            "use": "@vercel/node",
            "config": {
                "includeFiles": [
                    "server/assets/**",
                    "server/src/assets/**",
                    "server/node_modules/pdfkit/js/standard-fonts/**"
                ]
            }
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "server/src/index.ts"
        },
        {
            "src": "/(.*)",
            "dest": "client/$1"
        }
    ]
}